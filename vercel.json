{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/new/dalalmachine/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://dalalmachines.onrender.com/api/$1" },
    { "source": "/new/Machinery/(.*)", "destination": "/new/dalalmachine/$1" },
    { "source": "/new", "destination": "/new/dalalmachine/index.html" },
    { "source": "/new/", "destination": "/new/dalalmachine/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/superadmin", "destination": "/superadmin/index.html" }
  ]
}
